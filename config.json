{
    "hyper_keys_map": {
        "q": {"key": "exit"},
        "h": {"key": "left_arrow"},
        "j": {"key": "down_arrow"},
        "k": {"key": "up_arrow"},
        "l": {"key": "right_arrow"},
        "y": {"key": "home"},
        "o": {"key": "end"},
        "u": {"key": "page_down"},
        "i": {"key": "page_up"},
        "e": {"key": "escape"},
        "m": {"key": "delete"},
        "n": {"key": "delete", "modifiers": ["control"]},
        "b": [{"key": "home", "modifiers": ["shift"]}, {"key": "delete"}],
        "comma": {"key": "forward_delete"},
        "period": {"key": "forward_delete", "modifiers": ["control"]},
        "slash": [{"key": "end", "modifiers": ["shift"]}, {"key": "forward_delete"}],
        "c": {"key": "c", "modifiers": ["control"]},
        "v": {"key": "v", "modifiers": ["control"]},
        "k_1": {"key": "f1"},
        "k_2": {"key": "f2"},
        "k_3": {"key": "f3"},
        "k_4": {"key": "f4"},
        "k_5": {"key": "f5"},
        "k_6": {"key": "f6"},
        "k_7": {"key": "f7"},
        "k_8": {"key": "f8"},
        "k_9": {"key": "f9"},
        "k_0": {"key": "f10"},
        "minus": {"key": "f11"},
        "equal": {"key": "f12"}
    },
    "blacklist": [],
    "verbose": {
        "on_state": false,
        "on_event": false,
        "on_action": false
    },
    "hold_as_hyper": true
}
